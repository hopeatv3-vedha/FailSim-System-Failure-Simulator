SYSTEM ECommerce

GROUP Frontend
GROUP CoreServices
GROUP DataLayer
GROUP Infrastructure

COMPONENT WebApp TYPE CLIENT
    GROUP Frontend
    STATE RUNNING
    CRITICALITY HIGH
END

COMPONENT Gateway TYPE GATEWAY
    GROUP Frontend
    STATE RUNNING
    CRITICALITY HIGH
END

COMPONENT OrderService TYPE SERVICE
    GROUP CoreServices
    STATE RUNNING
    CRITICALITY HIGH
END

COMPONENT PaymentService TYPE SERVICE
    GROUP CoreServices
    STATE RUNNING
    CRITICALITY CRITICAL
END

COMPONENT OrderDB TYPE DATABASE
    GROUP DataLayer
    STATE RUNNING
    CRITICALITY CRITICAL
END

COMPONENT PaymentDB TYPE DATABASE
    GROUP DataLayer
    STATE RUNNING
    CRITICALITY CRITICAL
END

COMPONENT Redis TYPE CACHE
    GROUP DataLayer
    STATE RUNNING
    CRITICALITY MEDIUM
END

COMPONENT MessageQueue TYPE QUEUE
    GROUP Infrastructure
    STATE RUNNING
    CRITICALITY HIGH
END

COMPONENT OrderWorker TYPE WORKER
    GROUP CoreServices
    STATE RUNNING
    CRITICALITY MEDIUM
END

COMPONENT BackupDB TYPE BACKUP
    GROUP DataLayer
    STATE STANDBY
    CRITICALITY HIGH
END

CONNECTS Gateway TO OrderService
CONNECTS Gateway TO PaymentService

DEPENDS OrderService ON OrderDB
DEPENDS OrderService ON Redis
DEPENDS PaymentService ON PaymentDB
DEPENDS OrderWorker ON MessageQueue

OPTIONAL PaymentService ON Redis

RECOVERY OrderDB
    USE BackupDB
    REDIRECT OrderService TO BackupDB
END

SCENARIO OrderDatabaseFailure
    FAIL OrderDB
END

SCENARIO MultiFailure
    FAIL OrderDB
    FAIL PaymentDB
END
